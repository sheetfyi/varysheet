# 本地开发环境变量模板：复制成 .dev.vars 后按需修改
#   Windows PowerShell: Copy-Item .dev.vars.example .dev.vars
#   macOS / Linux:      cp .dev.vars.example .dev.vars
#
# .dev.vars 已在 .gitignore 里，切勿提交（里面放的是真实密钥）。
# 线上不要用这个文件：用 `npx wrangler secret put <NAME>`，或配置仓库同名的 GitHub Secrets，
# deploy 阶段会自动 sync 到 Worker。详见 DEPLOY.md 6.6。

# Resend 发信密钥（https://resend.com/api-keys）。
# 留空 = 不发真邮件：注册确认码直接回显在接口响应里（devCode，仅测试域可用），
# 本地开发与 CI 冒烟测试靠它自动跑完注册流程。
RESEND_API_KEY=
# 发件人。onboarding@resend.dev 只能发给 Resend 账号本人的邮箱；绑定自己的域名后再改。
RESEND_FROM_EMAIL=Varysheet <onboarding@resend.dev>

# 超级管理员：这两个值一配上，第一次登录（或 GET /api/session）就会自动创建 / 提升该账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Smoke1admin
# 只有在忘记管理员密码时才临时设为 true：下一次登录用 ADMIN_PASSWORD 覆盖现有密码，改完记得删掉
# ADMIN_RESET_PASSWORD=true

# 保留测试域白名单（wrangler.jsonc 里也配了一份，这里可以按需加自己的测试域）
AUTH_ECHO_CODE_DOMAINS=example.com,example.org,example.net

# ---- 表格分片库（storage split）------------------------------------------
# 表格数据存在独立的分片库（wrangler.jsonc 里的 DB_TABLES_BASIC / DB_TABLES_PRO）。
# 本地 `wrangler dev --local` 直接按 database_id 建本地 sqlite，所以下面两项**可以留空**：
# 绑定上的主分片不需要走 HTTP 接口。
# 只有当你想在本地试用「后台 → 存储分片 → 新建备用库 / 查看用量」（动态挂载的库
# 没法加 Worker 绑定，只能走 Cloudflare D1 HTTP 接口）时才需要填：
#   CLOUDFLARE_ACCOUNT_ID   Cloudflare 账号 ID（wrangler whoami 里能看到）
#   CLOUDFLARE_API_TOKEN    需要 Account > D1 > Edit 权限
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 基础表格的容量上限（wrangler.jsonc 里也配了一份，这里改的是本地 dev 的值）。
# 到上限后只拦「增长」：新建 / 批量新建 / 复制记录 / 上传附件会被
# 403 capacity_exceeded 挡下，查看 / 查询 / 改已有记录 / 删除都不受影响；
# 侧边栏里每张表后面的进度条显示的就是这两个维度的用量。
# 专业表格不限容量，这两个值对它没有影响。
# 本地想快点试出「已满」效果，可以把记录数调小（比如 10）。
MAX_DATABASE_RECORDS=500
# 试用表格的容量上限（默认 100 条记录 / 512MB 附件；专业表格不限）
TRIAL_MAX_DATABASE_RECORDS=100
TRIAL_MAX_DATABASE_STORAGE_MB=512
# 单表附件合计上限（MB）
MAX_DATABASE_STORAGE_MB=1024
# 数据保留期（天）：**按「最后一次使用」（编辑 / 查询）算**，超期的记录与附件会被定时任务清除。
#   试用表格：TRIAL_TABLE_RETENTION_DAYS，默认 365（1 年）
#   基础表格：BASIC_TABLE_RETENTION_DAYS，默认 1825（5 年）
#   专业表格：长期保留，不清理
# 本地想验证清理逻辑，可以把它们调成 0 以外的极小值（例如 1）配合手动改数据，
# 或者直接调管理员接口 POST /api/admin/maintenance/retention 手动跑一次。
BASIC_TABLE_RETENTION_DAYS=1825
TRIAL_TABLE_RETENTION_DAYS=365

# ---- XorPay 收款（表格名额购买）------------------------------------------
# 正式配置推荐直接填在「后台 → 站点设置」里（存 D1，保存完立刻生效，不用重新部署）：
#   XorPay 应用 ID（appid）+ 应用密钥（app secret），在 XorPay 后台「应用配置」里；
#   填好之后，侧边栏的购买弹窗就会显示微信支付二维码。
# 下面这两个环境变量是**兜底**（两边都没有时购买走「自助直通」：下单即到账、不真的收钱），
# 本地开发想走完整的支付链路就配上它们 + 假网关：
#   终端 A：npm run fake:xorpay
#   终端 B：npm run dev
#   模拟付款：curl.exe -X POST http://127.0.0.1:8788/__pay/<订单号>
XORPAY_AID=
XORPAY_APP_SECRET=
# 接口基址：指向本地假网关（见 scripts/fake-xorpay.mjs）；留空 = 官方 https://xorpay.com
XORPAY_API_BASE=http://127.0.0.1:8788
# 开放的支付方式，逗号分隔。默认只有 native（微信扫码）；XorPay 开通支付宝后写 alipay 或 native,alipay
XORPAY_PAY_TYPES=native
# 回调地址用的公网基址（本地不用配，就取当前请求的 origin）。线上配成绑定的自定义域名，
# 例如 PUBLIC_BASE_URL=https://varysheet.example.com —— 回调打不进来会「付了钱不到账」。
PUBLIC_BASE_URL=
