{
  "name": "varysheet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Notion-like flexible table information management system on Cloudflare Workers + D1 + R2",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:web": "vite",
    "build": "npm run build:client",
    "build:client": "vite build",
    "preview": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cloudnotion-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloudnotion-db --remote",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "cf-typegen": "wrangler types",
    "test:e2e": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  }
}
